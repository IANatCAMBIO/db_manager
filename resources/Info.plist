<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CFBundleName, CFBundleDisplayName, CFBundleIdentifier,
         CFBundleExecutable and CFBundleIconFile (from src/identity.h),
         CFBundleShortVersionString and CFBundleVersion (from VERSION),
         LSMinimumSystemVersion and CambioDbBuildDate (UTC, ISO 8601) are
         added by the Makefile. -->
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Ian Campbell. BSD 3-Clause License.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- A menu bar item, not a Dock icon: the app has no main window of
